# .env.example

# ── LLM Provider API Keys ────────────────────────────────────────────────
# Set only the key(s) for the provider(s) you intend to use.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=agentapi
MONGO_COLLECTION=conversations
MONGO_SESSION_ID=default

# ── Default Provider ─────────────────────────────────────────────────────
# Supported values: openai | gemini | openrouter
# This value is validated at startup — unsupported values will produce
# a clear error message listing available options.
DEFAULT_PROVIDER=openai